{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: debug",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-O2",
                "-fopenmp",
                "\"${file}\"",
                "-o",
                "\"${fileDirname}/${fileBasenameNoExtension}\""
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build: release",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-O3",
                "-march=native",
                "-fopenmp",
                "\"${file}\"",
                "-o",
                "\"${fileDirname}/${fileBasenameNoExtension}\""
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run: active file",
            "type": "shell",
            "command": "\"${fileDirname}/${fileBasenameNoExtension}\"",
            "dependsOn": "Build: debug",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}